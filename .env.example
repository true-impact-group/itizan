#--------------------------------------------------------------------------
# Itizan - example configuration. Copy to .env and fill in the blanks.
# Never commit .env. In production use real secrets and APP_DEBUG=false.
#--------------------------------------------------------------------------

APP_NAME=Itizan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Saudi Arabia has no daylight saving; appointments and dose times are stored in local time.
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Behind a load balancer / reverse proxy: comma separated proxy IPs, or * to trust all.
TRUSTED_PROXIES=

#--------------------------------------------------------------------------
# Logging. Production: LOG_STACK=daily,stderr and LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
# gives rotating files plus structured JSON lines (each with request_id) for your log collector.
#--------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_STDERR_FORMATTER=

#--------------------------------------------------------------------------
# PostgreSQL. Use a dedicated least-privilege role, not the postgres superuser.
#--------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=itizan
DB_USERNAME=itizan
DB_PASSWORD=
DB_SSLMODE=prefer

#--------------------------------------------------------------------------
# Sessions, cache, queue: all on PostgreSQL, so no Redis is required.
# Production: SESSION_SECURE_COOKIE=true and keep SESSION_ENCRYPT=true.
#--------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Private uploads (lab results, symptom photos). Served only through an authorised route.
FILESYSTEM_DISK=local
PRIVATE_UPLOADS_DISK=local

#--------------------------------------------------------------------------
# Mail. "log" writes emails to the log (development). Use smtp in production.
#--------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@itizan.test"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Itizan business settings
#--------------------------------------------------------------------------
# WhatsApp support number, international format without "+" or leading zeros (00966551475212 -> 966551475212).
WHATSAPP_NUMBER=966551475212
SUPPORT_EMAIL=support@itizan.test

# Shown on payment receipts.
COMPANY_NAME=Itizan
COMPANY_VAT_NUMBER=

# Telemedicine (FTMS). {reference} is replaced with the appointment reference.
FTMS_JOIN_URL=https://ftms.example.com/join/{reference}

#--------------------------------------------------------------------------
# Payments. "sandbox" never moves money and is refused in production.
# Replace with a real driver (see README: Payments) before going live.
# Tabby/Tamara stay off until the merchant account is approved.
#--------------------------------------------------------------------------
PAYMENT_DRIVER=sandbox
PAYMENT_WEBHOOK_SECRET=
PAYMENT_APPLE_PAY_ENABLED=true
PAYMENT_MADA_ENABLED=true
PAYMENT_TABBY_ENABLED=false
PAYMENT_TAMARA_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
